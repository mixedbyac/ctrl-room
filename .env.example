# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never share

# The email you sign in with. This account gets the Engineer view.
ENGINEER_EMAIL=you@example.com

# Your app's public address (used in text messages)
NEXT_PUBLIC_SITE_URL=https://ctrlroom.yourdomain.com

# Dropbox (developer app with "App folder" or "Full Dropbox" access)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT=/Clients

# Twilio (texts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14075550100

# Optional: Spotify keys add genres and follower counts to artist pages (works without them)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
